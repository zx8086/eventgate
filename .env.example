PORT=3000

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_GATEWAY=eventgate-gateway
KAFKA_CLIENT_ID_WRITER=eventgate-writer
KAFKA_GROUP_ID=autoops-couchbase-writer-v1
KAFKA_TOPIC_RAW=ops.elastic.autoops.raw.v1
KAFKA_TOPIC_EVENTS=ops.elastic.autoops.events.v1
KAFKA_TOPIC_DLQ=ops.elastic.autoops.dlq.v1


# Capella connection string. In prod must start with couchbases:// (TLS).
# Format: couchbases://cb.<cluster-id>.cloud.couchbase.com
# For VPC private endpoints: private-endpoint.<cluster-id>.cloud.couchbase.com
COUCHBASE_CONNSTR=couchbases://cb.<cluster-id>.cloud.couchbase.com
COUCHBASE_USERNAME=<service-account-username>
COUCHBASE_PASSWORD=<service-account-password>
COUCHBASE_BUCKET=monitoring
COUCHBASE_SCOPE=auto_ops
COUCHBASE_HISTORY_COLLECTION=events
COUCHBASE_STATE_COLLECTION=state

TENANT=elastic-cloud
ENVIRONMENT=dev
LOG_LEVEL=info

# --- AWS deployment ---
# Kafka SASL mechanism: "none" for local Redpanda, "iam" for AWS MSK Serverless.
KAFKA_AUTH=none
# AWS region for MSK IAM SASL token signing. Required when KAFKA_AUTH=iam.
KAFKA_REGION=
# Set to "false" to skip Couchbase entirely (writer logs events only). Defaults to "true".
COUCHBASE_ENABLED=true
