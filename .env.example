PORT=3000

# --- Kafka (all providers) ---
# Required for every provider:
#   KAFKA_PROVIDER         local | msk | confluent
#   KAFKA_CLIENT_ID        producer client id
#   KAFKA_BROKERS          comma-separated bootstrap brokers
# Exception: for KAFKA_PROVIDER=msk, KAFKA_BROKERS may be omitted when
# MSK_CLUSTER_ARN is set (brokers discovered via GetBootstrapBrokersCommand).
KAFKA_PROVIDER=local
KAFKA_CLIENT_ID=eventgate-gateway
KAFKA_BROKERS=localhost:9092

# --- AWS MSK provider extras ---
# Required when KAFKA_PROVIDER=msk:
#   MSK_REGION             AWS region of the cluster
#   MSK_AUTH_MODE          iam (default) | tls | none
# Plus either KAFKA_BROKERS (above) or:
#   MSK_CLUSTER_ARN        ARN; brokers discovered via GetBootstrapBrokersCommand
#MSK_REGION=eu-central-1
#MSK_AUTH_MODE=iam
#MSK_CLUSTER_ARN=arn:aws:kafka:eu-central-1:<account>:cluster/<name>/<uuid>

# --- Confluent Cloud provider extras ---
# Required when KAFKA_PROVIDER=confluent (set KAFKA_BROKERS to the
# pkc-*.confluent.cloud bootstrap servers).
#CONFLUENT_API_KEY=
#CONFLUENT_API_SECRET=

# --- Routes ---
# Webhook routes are declared as a JSON array. Each route's `topic` must
# match T_PRIVATE_SOURCE_<SYSTEM>_<ENTITY>; `dlqTopic` (optional) must
# equal DLQ_T_<topic>. The defaults in src/config/defaults.ts already
# include the elastic-autoops route below — set ROUTES_JSON only to
# add new vendors or override per environment.
#ROUTES_JSON='[{"name":"elastic-autoops","path":"/webhooks/elastic/autoops","topic":"T_PRIVATE_SOURCE_ELASTIC_AUTOOPS","dlqTopic":"DLQ_T_PRIVATE_SOURCE_ELASTIC_AUTOOPS","keyFields":["resourceId","deployment-id"],"idempotency":"elastic-autoops"}]'

# Alternative source: a mounted JSON file. Takes precedence over
# ROUTES_JSON when set. Required to enable the admin endpoint (below).
#ROUTES_FILE=/etc/eventgate/routes.json

# --- Admin endpoint ---
# When ADMIN_TOKEN (min 32 chars) AND ROUTES_FILE are both set, the
# gateway exposes PUT /admin/routes (X-Admin-Token-protected) for
# runtime route changes. Without ROUTES_FILE the endpoint stays off —
# in-memory-only edits would be lost on restart.
#ADMIN_TOKEN=

ENVIRONMENT=dev
LOG_LEVEL=info
