# HTTP port the gateway listens on. Defaults to 3000.
#PORT=3000

# --- Kafka (all providers) ---
# Required for every provider:
#   KAFKA_PROVIDER         local | msk | confluent
#   KAFKA_CLIENT_ID        producer client id
#   KAFKA_BROKERS          comma-separated bootstrap brokers
# Exception: for KAFKA_PROVIDER=msk, KAFKA_BROKERS may be omitted when
# MSK_CLUSTER_ARN is set (brokers discovered via GetBootstrapBrokersCommand).
KAFKA_PROVIDER=local
KAFKA_CLIENT_ID=eventgate-gateway
KAFKA_BROKERS=localhost:9092

# --- AWS MSK provider extras ---
# Required when KAFKA_PROVIDER=msk:
#   MSK_REGION             AWS region of the cluster
#   MSK_AUTH_MODE          iam | tls | none (default)
# Plus either KAFKA_BROKERS (above) or:
#   MSK_CLUSTER_ARN        ARN; brokers discovered via GetBootstrapBrokersCommand
#MSK_REGION=eu-central-1
#MSK_AUTH_MODE=none
#MSK_CLUSTER_ARN=arn:aws:kafka:eu-central-1:<account>:cluster/<name>/<uuid>

# --- Confluent Cloud provider extras ---
# Required when KAFKA_PROVIDER=confluent (set KAFKA_BROKERS to the
# pkc-*.confluent.cloud bootstrap servers).
#CONFLUENT_API_KEY=
#CONFLUENT_API_SECRET=

# --- Routes ---
# Webhook routes are declared as a JSON array. Every field is mandatory:
#   name           Human-readable route id
#   path           HTTP path (must not collide with /healthz or /admin/routes)
#   topic          T_PRIVATE_SOURCE_<SYSTEM>_<ENTITY>
#   dlqTopic       DLQ_T_<topic> (declared so downstream consumers know
#                  where retries land; gateway never writes here)
#   sourceHeader   Value of the 'source' Kafka header
#   keyFields      Body fields consulted in order for the partition key
#   idempotency    Registered strategy name (only 'elastic-autoops' ships;
#                  add new strategies in src/gateway/idempotencyStrategies.ts)
# The defaults in src/config/defaults.ts already include the elastic-autoops
# route below — set ROUTES_JSON only to add new vendors or override per env.
#ROUTES_JSON='[{"name":"elastic-autoops","path":"/webhooks/elastic/autoops","topic":"T_PRIVATE_SOURCE_ELASTIC_AUTOOPS","dlqTopic":"DLQ_T_PRIVATE_SOURCE_ELASTIC_AUTOOPS","sourceHeader":"elastic-autoops","keyFields":["resourceId","deployment-id"],"idempotency":"elastic-autoops"}]'

# Alternative source: a mounted JSON file. Takes precedence over
# ROUTES_JSON when set. Required to enable the admin endpoint (below).
#ROUTES_FILE=/etc/eventgate/routes.json

# --- Admin endpoint ---
# When ADMIN_TOKEN (min 32 chars) AND ROUTES_FILE are both set, the
# gateway exposes PUT /admin/routes (X-Admin-Token-protected) for
# runtime route changes. Without ROUTES_FILE the endpoint stays off —
# in-memory-only edits would be lost on restart.
#ADMIN_TOKEN=

# --- SQLite outbox ---
# In-process durable buffer between HTTP accept and Kafka publish. Defaults
# in src/config/defaults.ts cover dev; uncomment to override.
#   OUTBOX_ENABLED         true | false (false = inline publish, escape hatch)
#   OUTBOX_DB_PATH         SQLite file path (use :memory: for tests)
#   OUTBOX_BATCH_SIZE      Max rows the drainer fetches per loop iteration
#   OUTBOX_BACKOFF_MAX_MS  Cap on exponential backoff between retries (ms)
#   OUTBOX_MAX_AGE_HOURS   After this age a stuck row is marked 'failed'
#   OUTBOX_IDLE_POLL_MS    Poll interval when the previous batch was empty
#   OUTBOX_BUSY_POLL_MS    Poll interval when the previous batch was full
#   OUTBOX_BACKLOG_WARN    Pending-row count above which a warn is logged
#OUTBOX_ENABLED=true
#OUTBOX_DB_PATH=./data/outbox.db
#OUTBOX_BATCH_SIZE=100
#OUTBOX_BACKOFF_MAX_MS=600000
#OUTBOX_MAX_AGE_HOURS=24
#OUTBOX_IDLE_POLL_MS=5000
#OUTBOX_BUSY_POLL_MS=250
#OUTBOX_BACKLOG_WARN=50000

ENVIRONMENT=dev
LOG_LEVEL=info
