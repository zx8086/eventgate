PORT=3000

# --- Kafka provider ---
# Which Kafka backend to connect to. One of: local | msk | confluent.
KAFKA_PROVIDER=local
KAFKA_CLIENT_ID=eventgate-gateway

# Topics (all providers).
KAFKA_TOPIC_RAW=ops.elastic.autoops.raw.v1
KAFKA_TOPIC_EVENTS=ops.elastic.autoops.events.v1
KAFKA_TOPIC_DLQ=ops.elastic.autoops.dlq.v1

# --- Local provider (Redpanda) ---
# Comma-separated bootstrap brokers. Defaults to localhost:9092.
KAFKA_LOCAL_BOOTSTRAP_SERVERS=localhost:9092

# --- AWS MSK provider ---
# Required when KAFKA_PROVIDER=msk:
#   MSK_REGION             AWS region of the cluster
#   MSK_AUTH_MODE          iam (default) | tls | none
# Plus exactly one of:
#   MSK_CLUSTER_ARN        ARN; brokers discovered via GetBootstrapBrokersCommand
#   MSK_BROKERS            CSV bootstrap brokers (skip discovery)
#MSK_REGION=eu-central-1
#MSK_AUTH_MODE=iam
#MSK_CLUSTER_ARN=arn:aws:kafka:eu-central-1:<account>:cluster/<name>/<uuid>
#MSK_BROKERS=

# --- Confluent Cloud provider ---
# Required when KAFKA_PROVIDER=confluent.
#CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.eu-central-1.aws.confluent.cloud:9092
#CONFLUENT_API_KEY=
#CONFLUENT_API_SECRET=

TENANT=elastic-cloud
ENVIRONMENT=dev
LOG_LEVEL=info
